{
	"singleQuote": true,
	"tabWidth": 2,
	"useTabs": false,
	"endOfLine": "auto",
	"semi": false,
	"arrowParens": "always",
	"bracketSpacing": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"printWidth": 80,
	"plugins": [
		"prettier-plugin-organize-imports",
		"prettier-plugin-svelte"
	]
}