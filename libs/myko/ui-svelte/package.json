{
  "name": "@myko/ui-svelte",
  "version": "4.0.0-canary.26",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && svelte-kit sync && svelte-package && publint",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "build:watch": "vite build && svelte-kit sync && svelte-package && publint && chokidar 'src/**/*.ts' 'src/**/*.svelte' -c 'vite build && svelte-kit sync && svelte-package && publint'"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./client": {
      "svelte": "./src/lib/services/client-exports.ts",
      "default": "./src/lib/services/client-exports.ts"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "flux": {
    "tasks": ["build", "check"]
  },
  "dependencies": {
    "@myko/core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/luxon": "^3.4.2",
    "@types/ramda": "^0.30.2",
    "chokidar-cli": "^3.0.0",
    "luxon": "^3.5.0",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier": "^3.3.2",
    "publint": "^0.2.0",
    "ramda": "^0.30.1",
    "rxjs": "^7.8.1",
    "svelte-check": "^4.0.0",
    "svelte-inview": "^4.0.4",
    "svelte-watch-resize": "^1.0.3",
    "svelte": "^5.17.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.11"
  }
}