{
  "dependencies": {
    "msgpackr": "^1.11.0",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0"
  },
  "description": "Myko client and generated types",
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "flux": {
    "bridges": [
      "cargo:myko"
    ],
    "tasks": [
      "build",
      "check",
      "gen",
      "publish"
    ]
  },
  "main": "./src/index.ts",
  "name": "@myko/core",
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "libs/myko/ts",
    "type": "git",
    "url": "https://github.com/ignition-is-go/myko"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit --skipLibCheck",
    "test": "echo 'no tests yet'"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "4.6.0"
}
