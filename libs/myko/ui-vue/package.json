{
  "dependencies": {
    "@myko/core": "workspace:*"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "luxon": "^3.5.0",
    "prettier": "^3.3.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.11",
    "vite-plugin-dts": "^3.7.0",
    "vue": "^3.4.0",
