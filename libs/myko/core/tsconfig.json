{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "stripInternal": false,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "outDir": "_types",
    "rootDir": "src",
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
