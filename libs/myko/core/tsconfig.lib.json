{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "module": "commonjs",
    "outDir": "dist",
    "declaration": true,
    "rootDir": "./src",
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts", "**/*.d.ts"],
  "include": ["**/*.ts"]
}
