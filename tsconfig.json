{
  "extends": "@tsconfig/bun",
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "strictNullChecks": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["apps", "libs"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/build",
    "./target",
    "./tools",
    "**/*.cjs",
    "libs/streamdeck",
    "libs/ableton",
    "libs/electron-ipc-store",
    "libs/svelte-schema-form",
    "apps/execs",
    "apps/docs.rship.io",
    "apps/adapters",
    "apps/labs",
    "apps/ui",
    "apps/link-ui"
  ]
}
