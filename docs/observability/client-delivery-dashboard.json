{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Myko client delivery diagnostics",
  "uid": "myko-client-delivery",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "myko",
    "rship",
    "delivery"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(myko_ws_delivery_connections, instance)",
        "definition": "label_values(myko_ws_delivery_connections, instance)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "peer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(myko_ws_delivery_connections{instance=~\"$instance\"}, peer)",
        "definition": "label_values(myko_ws_delivery_connections{instance=~\"$instance\"}, peer)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(myko_ws_delivery_connections{instance=~\"$instance\",peer=~\"$peer\"}, client_id)",
        "definition": "label_values(myko_ws_delivery_connections{instance=~\"$instance\",peer=~\"$peer\"}, client_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Frames written / second (top operations)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, rate(myko_ws_delivery_messages_total{instance=~\"$instance\",peer=~\"$peer\",client_id=~\"$client\"}[$__rate_interval]))",
          "legendFormat": "{{peer}} {{client_id}} {{kind}} {{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Encoded bytes / second (top operations)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
