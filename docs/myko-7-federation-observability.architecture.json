  "cards": [
    {
      "dot": "rose",
      "title": "Reactive authority",
      "items": [
        "A coherent live report joins the local realm with grants, uses, approvals, and leases.",
        "Authority revisions replace 50 ms polling; denials, leases, approvals, and bounded use remain durable."
      ]
    },
    {
      "dot": "cyan",
      "title": "Handler delivery",
      "items": [
        "Transport identity is bound before admission; declared claims add ReadState, Subscribe, and FollowHandler.",
        "Initial state or delta frames drain immediately; data or authority revisions trigger continuation checks."
      ]
    },
    {
      "dot": "emerald",
      "title": "Operational visibility",
      "items": [
        "Stable request and frame kinds span startup, routing, authorization, handlers, transports, and shutdown.",
        "Redb replay and LAN roster metrics expose latency and disappearance without protocol changes."
      ]
    }
