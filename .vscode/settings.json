{
  // "html.format.wrapAttributes": "force-aligned",
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  // "editor.codeActionsOnSave": {
  // 	"source.fixAll.prettier": true
  // },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "html.format.enable": true,
  "typescript.format.enable": true,
  "search.exclude": {
    "**/coverage": true
  },
  "editor.tabSize": 2,
  "json.schemas": [
    {
      "fileMatch": ["/apps/intake/src/app/testData/*"],
      "url": "/apps/intake/src/assets/schedule-exchange-schema_v1.json"
    },
    {
      "fileMatch": ["apps/sherlock/watson-cli/src/assets/watson.config.json"],
      "url": "/generated/watson-cli-config-schema.json"
    }
  ],
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },

  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "editor.formatOnPaste": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.inlayHints.enabled": "offUnlessPressed"
  },
  "rust-analyzer.inlayHints.closureStyle": "rust_analyzer",
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.inlayHints.bindingModeHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": true,
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "clippy",
  "git.autofetch": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
