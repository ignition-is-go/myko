{
  // "html.format.wrapAttributes": "force-aligned",
  "editor.formatOnSave": true,
  "files.exclude": {
    "dist": true,
    "node_modules": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  // "editor.codeActionsOnSave": {
  // 	"source.fixAll.prettier": true
  // },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "html.format.enable": false,
  "typescript.format.enable": true,
  "findrelated.applyRulesets": ["angular", "tests"],
  "findrelated.rulesets": [
    {
      "name": "angular",
      "rules": [
        {
          "locators": ["$1.html"],
          "pattern": "(.*)\\.(?:ts|js)$"
        },
        {
          "locators": ["$1.ts"],
          "pattern": "(.*)\\.html$"
        },
        {
          "locators": ["$1.scss"],
          "pattern": "(.*)\\.html$"
        },
        {
          "locators": ["$1.html"],
          "pattern": "(.*)\\.scss$"
        }
      ]
    },
    {
      "name": "tests",
      "rules": [
        {
          "pattern": "(.*)\\/(.*)\\.ts$",
          "locators": ["$1/__tests__/$2.test.ts", "$1/__tests__/$2.spec.ts"]
        },
        {
          "pattern": "(.*)\\/__tests__\\/(.*)\\.test\\.ts$",
          "locators": ["$1/$2.ts"]
        },
        {
          "pattern": "(.*)\\/__tests__\\/(.*)\\.spec\\.ts$",
          "locators": ["$1/$2.ts"]
        }
      ]
    }
  ],
  "search.exclude": {
    "**/coverage": true
  },
  "editor.tabSize": 2,
  "typescript.preferences.importModuleSpecifier": "auto",
  "json.schemas": [
    {
      "fileMatch": ["/apps/intake/src/app/testData/*"],
      "url": "/apps/intake/src/assets/schedule-exchange-schema_v1.json"
    },
    {
      "fileMatch": ["apps/sherlock/watson-cli/src/assets/watson.config.json"],
      "url": "/generated/watson-cli-config-schema.json"
    }
  ],
  "nxConsole.useNVM": true,
  "nxConsole.enableTelemetry": false,
  "telemetry.enableTelemetry": false
}
