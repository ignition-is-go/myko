{
  // "html.format.wrapAttributes": "force-aligned",
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  // "editor.codeActionsOnSave": {
  // 	"source.fixAll.prettier": true
  // },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "html.format.enable": true,
  "typescript.format.enable": true,
  "search.exclude": {
    "**/coverage": true
  },
  "editor.tabSize": 2,
  "json.schemas": [
    {
      "fileMatch": ["/apps/intake/src/app/testData/*"],
      "url": "/apps/intake/src/assets/schedule-exchange-schema_v1.json"
    },
    {
      "fileMatch": ["apps/sherlock/watson-cli/src/assets/watson.config.json"],
      "url": "/generated/watson-cli-config-schema.json"
    }
  ],
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },

  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "editor.formatOnPaste": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "clippy",
  "git.autofetch": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },

  "python.envFile": "",
  "python.terminal.activateEnvironment": false,
  "prettier.semi": false,
  "prettier.singleAttributePerLine": true,
  "prettier.useTabs": true,
  "javascript.preferences.organizeImports": {},
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "SyncServer",
          "commands": ["cd apps/sync_server", "cargo watch -x run"]
        },
        {
          "name": "Server",
          "commands": ["cd apps/server", "pnpm dev"]
        },
        {
          "name": "UI",
          "commands": ["cd apps/ui", "pnpm dev"]
        }
      ]
    }
  ],
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "dotnet.defaultSolution": "disable"
}
