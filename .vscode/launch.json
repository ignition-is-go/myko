    ////////////
    // Intake
    ///////////

    {
      "type": "node",
      "request": "attach",
      "name": "Attach Intake Server",
      "port": 5959,
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },

    /////////////
    // Shared Lib
    /////////////

    {
      "type": "node",
      "request": "launch",
      "name": "Shared Lib - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        // Get the closest `jest.config.js` parent folder basename (it matches the project name in `angular.json`)
        "shared",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
