{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "command": "pnpm dev",
      "name": "Run pnpm dev",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/apps/ui"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Linkd",
      "program": "${workspaceFolder}/target/debug/linkd",
      "args": [],
      "cwd": "${workspaceFolder}/apps/linkd",
      "sourceLanguages": ["rust"],
      "preLaunchTask": "rust: cargo build"
    },
    {
      "type": "bun",
      "request": "attach",
      "name": "Attach Bun to Process",
      "url": "ws://localhost:9229/vscode"
    },
    {
      "type": "bun",
      "request": "attach",
      "name": "Attach to Noise Main",
      "url": "ws://localhost:9239/vscode"
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
