{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "Client Ng",
			"webRoot": "${workspaceFolder}/apps/rship-client/",
			"url": "http://localhost:4200",
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "Storybook Debug",
			"url": "http://localhost:6006",
			"sourceMaps": true,
			"webRoot": "${workspaceFolder}/apps/rship-client/",
			"sourceMapPathOverrides": {
				"webpack:///*": "${webRoot}/apps/rship-client/*",
				"webpack:///./*": "${webRoot}/apps/rship-client/*",
				"webpack:///src/*": "${webRoot}/apps/rship-client/*",
				"webpack:///./~/*": "${webRoot}/apps/rship-client/node_modules/*"
			}
		},
		{
			"type": "electron",
			"request": "launch",
			"name": "Electron UI",
			"appDir": "${workspaceFolder}/dist/apps/satellite-electron/",
			"url": "http://localhost:4200",
		},
		{
			"name": "Debug Main Process - served",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/dist/apps/satellite/src/main/main.js",
			"runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
			"windows": {
				"runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
			},
			"args": [
				"--serve"
			],
			"outputCapture": "std",
			"preLaunchTask": "build-satellite-main",
			"sourceMaps": true,
			"outFiles": [
				"dist/apps/satellite/"
			]
		}
	]
}
