{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    ////////
    // RSHIP
    ////////

    // Client
    {
      "type": "chrome",
      "request": "launch",
      "name": "Rship Client - Launch",
      "webRoot": "${workspaceFolder}/apps/rship/client/",
      "url": "http://localhost:4200",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*",
        "webpack:///*": "*",
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "meteor://💻app/*": "${webRoot}/*"
      }
    },

    // Client - Single File

    {
      "type": "node",
      "request": "launch",
      "name": "Rship Client - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        // Get the closest `jest.config.js` parent folder basename (it matches the project name in `angular.json`)
        "rship-client",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },

    // Server
    {
      "type": "node",
      "request": "attach",
      "name": "Rship Server - Attach",
      "port": 5858,
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },

    {
      "type": "node",
      "request": "attach",
      "name": "Rship Server - Attach Dev",
      "port": 9229,
      "address": "172.24.1.1",
      "remoteRoot": "/usr/src/app",
      "localRoot": "${workspaceFolder}/apps/rship/server/src",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/dist/apps/rship/server"],
      "sourceMaps": true,
      "restart": true
    },

    // Server - Single File
    {
      "type": "node",
      "request": "launch",
      "name": "Rship Server - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        // Get the closest `jest.config.js` parent folder basename (it matches the project name in `angular.json`)
        "rship-server-core",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      // this can be set to jest-mongodb* to debug things about the mongo env
      "env": { "DEBUG": "" },
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },

    // Rship Models
    // Rship Models - Single File
    {
      "type": "node",
      "request": "launch",
      "name": "Rship Models - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        // Get the closest `jest.config.js` parent folder basename (it matches the project name in `angular.json`)
        "rship-models",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      // this can be set to jest-mongodb* to debug things about the mongo env
      "env": { "DEBUG": "" },
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },

    // Rship Timeline
    // Timeline - Single File
    {
      "type": "node",
      "request": "launch",
      "name": "Rship Timeline - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        // Get the closest `jest.config.js` parent folder basename (it matches the project name in `angular.json`)
        "rship-timeline-core",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },

