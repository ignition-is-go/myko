{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "name": "Launch localhost",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/rship/client",
      "pathMappings": [
        {
          "url": "webpack:///libs",
          "path": "${workspaceFolder}/libs"
        },
        {
          "url": "webpack:///apps",
          "path": "${workspaceFolder}/apps"
        }
      ]
    },
    {
      "name": "Attach",
      "port": 9229,
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "type": "chrome",
      "request": "launch",
      "reAttach": true,
      "name": "Launch localhost (chrome)",
      "url": "http://localhost:4200",
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/**/*"],
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/rship/client",
      "pathMappings": [
        {
          "url": "webpack:///libs",
          "path": "${workspaceFolder}/libs"
        },
        {
          "url": "webpack:///apps",
          "path": "${workspaceFolder}/apps"
        }
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Rship Client - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "rship-client",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Node: Nodemon",
      "processId": "${command:PickProcess}",
      "restart": true,
      "protocol": "inspector"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Rship Server - Attach London",
      "port": 9229,
      "address": "10.147.17.99",
      "remoteRoot": "/usr/src/app",
      "localRoot": "${workspaceFolder}/dist/apps/rship/server",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/dist/**/*"],
      "sourceMaps": true,
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Rship Server - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
