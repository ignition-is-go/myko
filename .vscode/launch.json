      "port": 9878,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/apps/sherlock/server-nest"]
    },

    // JustNetworks

    // JN Client
    {
      "type": "chrome",
      "request": "launch",
      "name": "JN Client - Launch",
      "webRoot": "${workspaceFolder}/apps/just-networking/client/",
      "url": "http://localhost:4200",
      "sourceMapPathOverrides": {
