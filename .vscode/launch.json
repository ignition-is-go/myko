      "webRoot": "${workspaceFolder}/apps/sherlock/client/",
      "url": "http://localhost:4200"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Sherlock Server - Attach",
      "port": 9876,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*"]
    },
    {
      "type": "node",
      "request": "attach",
