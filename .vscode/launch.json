        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "meteor://💻app/*": "${webRoot}/*"
      }
    },
    // JN Server - Attach
    {
      "type": "node",
      "stopOnEntry": true,
      "request": "attach",
      "name": "JN Server - Attach",
      "port": 5858,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outFiles": [
        "${workspaceFolder}/apps/just-networking/server",
        "${workspaceFolder}/libs/just-networking/core"
      ]
    },
    // JN Domain Test - Single File
