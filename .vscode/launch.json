      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/apps/sherlock/watson"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Metadata Core - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "rship-metadata-core",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}",
        "--watch"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Alerts Core - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "rship-alerts-core",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}",
        "--watch"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach Intake Server",
      "port": 5859,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/**/*"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Shared Lib - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "shared",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      "env": {
        "DEBUG": ""
      },
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Server Utils - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "server-utils",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}",
        "--watch"
      ],
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Observation-Deck Client",
      "webRoot": "${workspaceFolder}/apps/observation-deck",
      "url": "http://localhost:4322"
    },
    {
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "name": "Firefox Client",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/client",
      "pathMappings": [
        {
          "url": "webpack:///src",
          "path": "${workspaceFolder}/apps/client/src"
        }
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Storybook Debug",
      "url": "http://localhost:6006",
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/client/",
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/apps/client/*",
        "webpack:///./*": "${webRoot}/apps/client/*",
        "webpack:///src/*": "${webRoot}/apps/client/*",
        "webpack:///./~/*": "${webRoot}/apps/client/node_modules/*"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Storybook Debug - Obs",
      "url": "http://localhost:6006",
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*",
        "webpack:///./~/*": "${webRoot}/node_modules/*"
      },
      "skipFiles": [".ts$"]
    },
    {
      "name": "Electron: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}/apps/satellite/",
      "timeout": 30000
    },
    {
      "name": "Electron: Main+Wiz",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/apps/satellite/src/main/main.js",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["--remote-debugging-port=9223", "--serve", "--force-wizard"],
      "outputCapture": "std",
      "preLaunchTask": "compile-satellite-main",
      "sourceMaps": true,
      "outFiles": ["dist/apps/satellite/"]
    },
    {
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/apps/satellite/src/main/main.js",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["--remote-debugging-port=9223", "--serve"],
      "outputCapture": "std",
      "preLaunchTask": "compile-satellite-main",
      "sourceMaps": true,
      "outFiles": ["dist/apps/satellite/"]
    },
    {
      "name": "Electron: Main - Dist",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist/apps/satellite/src/main/main.js",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["--remote-debugging-port=9223", "--force-wizard"],
      "outputCapture": "std",
      "preLaunchTask": "build-satellite-dist",
      "sourceMaps": true,
      "outFiles": ["dist/apps/satellite/"]
    },
    {
      "name": "Watson - Attach Main Process",
      "type": "node",
      "request": "attach",
      "restart": true,
      "port": 5858,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "User Microservice Nest - Attach",
      "port": 9878,
      "skipFiles": ["<node_internals>/**"],
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/apps/sherlock/server-nest"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "User Microservice Nest - Run Current File",
      "program": "${workspaceFolder}/node_modules/.bin/ng",
      "args": [
        "test",
        "user-schema",
        "--watch",
        "--run-in-band",
        "--code-coverage=false",
        "--test-file=${relativeFile}"
      ],
      "env": {
        "DEBUG": ""
      },
      "smartStep": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Electron: All+Wiz",
      "configurations": ["Electron: Main+Wiz", "Electron: Renderer"]
    },
    {
      "name": "Electron: All",
      "configurations": ["Electron: Main", "Electron: Renderer"]
    },
    {
      "name": "Electron: All - Dist",
      "configurations": ["Electron: Main - Dist", "Electron: Renderer"]
    }
  ]
}
