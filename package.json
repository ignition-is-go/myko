{
  "name": "rocketship-client",
  "scripts": {
    "build": "next build src",
    "start-development": "cross-env NODE_ENV=development node ./src/server.js",
    "start-testing": "cross-env NODE_ENV=testing node ./src/server.js",
    "start-prod": "cross-env NODE_ENV=production node ./src/server.js",
    "toolbox": "react-toolbox-themr",
    "dock": "docker build -t registry.rship.io/rocketship-client:latest .",
    "push-image": "docker push registry.rship.io/rocketship-client:latest",
    "dock+push": "npm run dock && docker push registry.rship.io/rocketship-client:latest"
  },
  "dependencies": {
    "@zeit/next-css": "^0.2.0",
    "@zeit/next-sass": "^0.2.0",
    "apollo-boost": "^0.1.7",
    "apollo-link-context": "^1.0.8",
    "apollo-link-http": "^1.5.4",
    "apollo-link-ws": "^1.0.8",
    "babel-eslint": "^8.2.3",
    "bootstrap": "^4.1.1",
    "classnames": "^2.2.5",
    "colornames": "^1.1.1",
    "cookie": "^0.3.1",
    "dotenv": "^5.0.1",
    "express": "^4.16.3",
    "graphql": "^0.13.2",
    "graphql-tag": "^2.9.2",
    "isomorphic-unfetch": "^2.0.0",
    "lodash": "^4.17.10",
    "mdi-react": "^3.4.0",
    "next": "6.1.1",
    "next-routes": "^1.4.2",
    "node-sass": "^4.9.0",
    "prop-types": "^15.6.1",
    "ramda": "^0.25.0",
    "rc-color-picker": "^1.2.6",
    "react": "^16.3.2",
    "react-apollo": "^2.1.4",
    "react-autosize-textarea": "^4.0.0",
    "react-bootstrap": "^0.32.1",
    "react-contexify": "^3.0.1",
    "react-custom-scrollbars": "^4.2.1",
    "react-dd-menu": "^2.0.2",
    "react-dnd": "^5.0.0",
    "react-dnd-html5-backend": "^5.0.1",
    "react-dom": "^16.3.2",
    "react-grid-layout": "^0.16.6",
    "react-modal": "^3.4.5",
    "react-resizable": "^1.7.5",
    "react-tabs": "^2.2.2",
    "react-tippy": "^1.2.2",
    "react-toolbox": "^2.0.0-beta.13",
    "react-tooltip": "^3.6.0",
    "subscriptions-transport-ws": "^0.9.14",
    "uuid": "^3.2.1",
    "webpack": "^3.7.1"
  },
  "devDependencies": {
    "cross-env": "^5.2.0",
    "eslint": "^4.17.0",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-react": "^7.6.1",
    "react-toolbox-themr": "^1.0.2",
    "riek": "^1.1.0"
  },
  "license": "MIT",
  "reactToolbox": {
    "include": [
      "AUTOCOMPLETE",
      "AVATAR",
      "BUTTON",
      "CARD",
      "CHECKBOX",
      "CHIP",
      "DATE_PICKER",
      "DIALOG",
      "DRAWER",
      "DROPDOWN",
      "INPUT",
      "LAYOUT",
      "LINK",
      "LIST",
      "MENU",
      "NAVIGATION",
      "OVERLAY",
      "PROGRESS_BAR",
      "RADIO",
      "RIPPLE",
      "SLIDER",
      "SNACKBAR",
      "SWITCH",
      "TABLE",
      "TABS",
      "TIME_PICKER",
      "TOOLTIP"
    ],
    "customProperties": {
      "animation-duration": "0.3s",
      "color-accent": "red",
      "color-accent-dark": "red",
      "color-primary-contrast": "red",
      "color-accent-contrast": "red"
    },
    "output": "src/static/themes/react-toolbox"
  }
}
