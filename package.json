{
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@types/ws": "^8.18.1",
    "html2canvas": "^1.4.1",
    "msgpackr": "^1.11.9",
    "openai": "^6.33.0",
    "socket.io-client": "^4.8.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/node": "^25.5.0",
    "@vercel/ncc": "^0.38.4",
    "bun-types": "^1.3.11",
    "fs-extra": "^11.3.4",
    "generate-template-files": "^3.2.1",
    "git-describe": "^4.1.1",
    "glob": "^13.0.6",
    "jsr": "^0.14.3",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "reflect-metadata": "^0.2.2",
    "tsc-watch": "^7.2.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "name": "rship",
  "overrides": {
    "@types/three": "^0.181.0",
    "rxjs": "7.8.2"
  },
  "packageManager": "bun@1.3.4",
  "private": true,
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "scripts": {
    "clean": "./tools/scripts/clean.sh",
    "cs:publish": "./tools/scripts/cs-publish.sh",
    "cs:version": "./tools/scripts/cs-update-versions.sh",
    "format:all": "prettier --write .",
    "gen": "bun run ./tools/scaffold/generate.js && bun run ./tools/scripts/generate-entity-index.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "postinstall": "cargo run -p release --quiet -- --sync --no-format || exit 0",
    "preinstall": "git submodule update --init --recursive",
    "prepare": "git config --local core.hooksPath .githooks",
    "py": "./tools/scripts/py.sh",
    "sync": "git submodule update --init --recursive",
    "test:smoke": "bun run ./tools/scripts/smoke-test.ts",
    "check": "bun run --filter '*' check",
    "versionecho": "bun run ./tools/scripts/version-echo.ts"
  },
  "trustedDependencies": [
    "@serialport/bindings-cpp",
    "@sveltejs/kit",
    "core-js",
    "esbuild",
    "msgpackr-extract",
    "node-rdkafka",
    "svelte-preprocess"
  ],
  "version": "4.0.0-canary.20"
}