{
	"name": "rship-client",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"build": "ng build",
		"test": "ng test",
		"lint": "nx lint && ng lint",
		"e2e": "ng e2e",
		"gen:graph": "npx jok graphql-client -e http://localhost:4000 -o generated/rship.ts",
		"gen:graph:trev": "npx jok graphql-client -e http://10.2.250.34:4000 -o generated/rship.ts",
		"gen:graph:remote": "npx jok graphql-client -e http://dev.rship.io/server -o generated/rship.ts",
		"storybook": "start-storybook -p 6006",
		"build-storybook": "build-storybook",
		"affected:apps": "nx affected:apps",
		"affected:libs": "nx affected:libs",
		"affected:build": "nx affected:build",
		"affected:e2e": "nx affected:e2e",
		"affected:test": "nx affected:test",
		"affected:lint": "nx affected:lint",
		"affected:dep-graph": "nx affected:dep-graph",
		"affected": "nx affected",
		"format": "nx format:write",
		"format:write": "nx format:write",
		"format:check": "nx format:check",
		"update": "ng update @nrwl/workspace",
		"update:check": "ng update",
		"workspace-schematic": "nx workspace-schematic",
		"dep-graph": "nx dep-graph",
		"help": "nx help",
		"satellite:package": "ng build satellite && npm run satellite:electron:build && npm run satellite:run-electron-builder",
		"satellite:client:dev": "ng serve satellite",
		"satellite:electron:dev": "npm run satellite:electron:build && npm run satellite:electron:served",
		"satellite:electron:build": "tsc -p apps/satellite/tsconfig.serve.json && sh tools/scripts/satellite-assets.sh",
		"satellite:electron:served": "wait-on http-get://localhost:4200/ && electron dist/apps/satellite/src/main/main.js --serve",
		"satellite:electron:run": "npm run satellite:electron:build && ng build satellite && electron dist/apps/satellite/src/main/main.js --remote-debugging-port=9223",
		"satellite:clear-db-mac": "rm -rf ~/Library/ApplicationSupport/Electron/satellite/db",
		"satellite:run-electron-builder": "electron-builder --config satellite.electron-builder.config.json --win --mac ",
		"satellite:regenerate-icon": "sh tools/scripts/make-satellite-icons.sh",
		"satellite:test": "ng test satellite --watch=true"
	},
	"private": true,
