{
  "name": "rship",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "build-docs": "turbo run build-docs",
    "publish": "./tools/scripts/export-version.sh && turbo run publish",
    "jsr": "turbo run jsr",
    "forge-publish": "turbo run forge-publish",
    "tauri-publish": "turbo run tauri-publish",
    "ionic:build": "npm run build",
    "py": "./tools/scripts/py.sh",
    "py:publish": "./tools/scripts/py-publish.sh",
    "rust:publish": "./tools/scripts/rust-publish.sh",
    "preinstall": "git submodule update --init --recursive --remote",
    "postinstall": "bun run ./tools/scripts/version-stamp.js",
    "versionstamp": "bun run ./tools/scripts/version-stamp.js",
    "versionwrite": "bun run ./tools/scripts/version-write.ts",
    "versionecho": "bun run ./tools/scripts/version-echo.ts",
    "gen": "bun run ./tools/scaffold/generate.js && bun run ./tools/scripts/generate-entity-index.js",
    "clean": "./tools/scripts/clean.sh",
    "sync": "git submodule update --init --recursive --remote",
    "format:all": "prettier --write .",
    "live": "turbo run live",
    "prepare": "git config --local core.hooksPath .githooks",
    "typecheck-sdk": "tsc --noEmit --skipLibCheck --project libs/sdk/ts/tsconfig.json",
    "typecheck-postgres": "tsc --noEmit --skipLibCheck --project libs/myko/postgres/tsconfig.json",
    "jsr-publish": "turbo run jsr-publish",
    "jsr-publish:dry": "turbo run jsr-publish:dry"
  },
  "packageManager": "pnpm@10.3.0+sha512.ee592eda8815a8a293c206bb0917c4bb0ff274c50def7cbc17be05ec641fc2d1b02490ce660061356bd0d126a4d7eb2ec8830e6959fb8a447571c631d5a2442d",
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@tsconfig/bun": "^1.0.7",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.2",
    "fs-extra": "^11.2.0",
    "generate-template-files": "^3.2.1",
    "git-describe": "^4.1.1",
    "glob": "^10.4.5",
    "jsr": "^0.12.4",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "pkg": "^5.8.1",
    "pnpm": "^10.3.0",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-svelte": "^3.2.7",
    "tsc-watch": "^6.2.1",
    "tslib": "^2.8.0",
    "turbo": "^2.4.1",
    "typescript": "^5.8.2"
  },
  "trustedDependencies": [
    "@serialport/bindings-cpp",
    "@sveltejs/kit",
    "core-js",
    "electron",
    "electron-winstaller",
    "esbuild",
    "msgpackr-extract",
    "node-rdkafka",
    "svelte-preprocess"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "@sveltejs/kit",
      "bufferutil",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract",
      "svelte-preprocess",
      "utf-8-validate",
      "workerd"
    ]
  },
  "version": "3.0.0-canary.581"
}