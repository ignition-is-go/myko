{
  "name": "rship",
  "version": "2.3.0",
  "license": "MIT",
  "scripts": {
    "start": "turbo run start",
    "start:rship": "turbo run start --filter=@rship/server --filter=@rship/gateway",
    "release:dev": "./tools/scripts/release.sh dev",
    "release:beta": "./tools/scripts/release.sh staging"
  },
  "packageManager": "pnpm",
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@types/node": "^18.11.18",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.1",
    "turbo": "^1.7.0",
    "typescript": "^4.9.4"
  },
  "husky": {
    "hooks": {
      "post-commit": [
        "node ./tools/scripts/version-stamp.js"
      ],
      "post-checkout": [
        "node ./tools/scripts/version-stamp.js"
      ]
    }
  }
}
