{
  "name": "rship",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "publish": "./tools/scripts/export-version.sh && turbo run publish",
    "jsr": "turbo run jsr",
    "forge-publish": "turbo run forge-publish",
    "tauri-publish": "turbo run tauri-publish",
    "rust": "./tools/scripts/rust.sh",
    "preinstall": "pnpm run sync",
    "postinstall": "pnpm run versionstamp",
    "versionstamp": "node ./tools/scripts/version-stamp.js",
    "transform": "node ./tools/scripts/transform.js",
    "gen": "node ./tools/scaffold/generate.js",
    "clean": "./tools/scripts/clean.sh",
    "setup": "pnpm run install && pnpm run sync",
    "ionic:build": "npm run build",
    "sync": "git submodule update --init --recursive --remote",
    "format": "lint-staged",
    "format:all": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-file .prettierignore"
  },
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^5.7.5",
    "@capacitor/core": "^5.7.5",
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "fs-extra": "^11.2.0",
    "generate-template-files": "^3.2.1",
    "git-describe": "^4.1.1",
    "glob": "^10.4.1",
    "husky": "^9.0.11",
    "jsr": "^0.12.4",
    "lint-staged": "^15.2.5",
    "nodemon": "^3.1.3",
    "pkg": "^5.8.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-svelte": "^3.2.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.6.2",
    "turbo": "^1.13.3",
    "typescript": "^5.4.5"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@serialport/bindings-cpp",
    "@sveltejs/kit",
    "core-js",
    "electron",
    "electron-winstaller",
    "esbuild",
    "msgpackr-extract",
    "node-rdkafka",
    "svelte-preprocess"
  ]
}
