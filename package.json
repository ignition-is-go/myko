{
  "name": "rship",
  "license": "MIT",
  "scripts": {
    "py": "./tools/scripts/py.sh",
    "py:publish": "./tools/scripts/py-publish.sh",
    "rust:publish": "./tools/scripts/rust-publish.sh",
    "jsr:publish": "bun run ./tools/scripts/publish-all-jsr.ts",
    "cs:version": "./tools/scripts/cs-update-versions.sh",
    "cs:publish": "./tools/scripts/cs-publish.sh",
    "preinstall": "git submodule update --init --recursive --remote",
    "postinstall": "bun run ./tools/scripts/version-stamp.js && bun run ./tools/scripts/jsr-import-map.ts",
    "versionstamp": "bun run ./tools/scripts/version-stamp.js",
    "versionwrite": "bun run ./tools/scripts/version-write.ts && bun run ./tools/scripts/jsr-import-map.ts",
    "versionecho": "bun run ./tools/scripts/version-echo.ts",
    "gen": "bun run ./tools/scaffold/generate.js && bun run ./tools/scripts/generate-entity-index.js",
    "clean": "./tools/scripts/clean.sh",
    "sync": "git submodule update --init --recursive --remote",
    "format:all": "prettier --write .",
    "prepare": "git config --local core.hooksPath .githooks",
    "typecheck-sdk": "tsc --noEmit --skipLibCheck --project libs/sdk/ts/tsconfig.json",
    "typecheck-postgres": "tsc --noEmit --skipLibCheck --project libs/myko/postgres/tsconfig.json"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@tsconfig/bun": "^1.0.7",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.2",
    "fs-extra": "^11.2.0",
    "generate-template-files": "^3.2.1",
    "git-describe": "^4.1.1",
    "glob": "^10.4.5",
    "jsr": "^0.12.4",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "pkg": "^5.8.1",
    "pnpm": "^10.3.0",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-svelte": "^3.2.7",
    "tsc-watch": "^6.2.1",
    "tslib": "^2.8.0",
    "typescript": "^5.8.2"
  },
  "trustedDependencies": [
    "@serialport/bindings-cpp",
    "@sveltejs/kit",
    "core-js",
    "electron",
    "electron-winstaller",
    "esbuild",
    "msgpackr-extract",
    "node-rdkafka",
    "svelte-preprocess"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "@sveltejs/kit",
      "@tailwindcss/oxide",
      "bufferutil",
      "bun",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "grpc-tools",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "svelte-preprocess",
      "utf-8-validate",
      "workerd"
    ]
  },
  "version": "3.0.0-alpha.18"
}