{
  "name": "rship",
  "version": "3.0.0",
  "license": "MIT",
  "scripts": {
    "server:serve": "turbo run build --filter=@rship/server && node --inspect=9229 apps/rship/server/dist/main.js",
    "server:dev": "nodemon --watch libs --watch apps/rship/server/src/ --exec \"npm run server:serve\" -e ts",
    "dirigera:serve": "turbo run build --filter=@rship/dirigera && node --inspect=9239 apps/rship/dirigera/dist/main.js",
    "dirigera:dev": "nodemon --watch libs --watch apps/rship/dirigera/src/ --exec \"npm run dirigera:serve\" -e ts",
    "pixera:serve": "turbo run build --filter=@rship/pixera && node --inspect=9249 apps/rship/pixera/dist/main.js",
    "pixera:dev": "nodemon --watch libs --watch apps/rship/pixera/src/ --exec \"npm run pixera:serve\" -e ts",
    "ventuz:serve": "turbo run build --filter=@rship/ventuz-exec && node --inspect=9259 apps/rship/ventuz/dist/main.js",
    "ventuz:dev": "nodemon --watch libs --watch apps/rship/ventuz/src/ --exec \"npm run ventuz:serve\" -e ts",
    "client:dev": "nodemon --watch libs --exec \"turbo run dev\"",
    "release:dev": "./tools/scripts/release.sh dev",
    "release:beta": "./tools/scripts/release.sh staging",
    "publish": "turbo run publish",
    "build": "turbo run build",
    "postinstall": "husky install"
  },
  "packageManager": "pnpm",
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@types/node": "^18.14.0",
    "esbuild": "^0.17.9",
    "fs-extra": "^11.1.0",
    "git-describe": "^4.1.1",
    "husky": "^8.0.3",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "turbo": "^1.8.1",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "post-commit": [
        "node ./tools/scripts/version-stamp.js"
      ],
      "post-checkout": [
        "node ./tools/scripts/version-stamp.js"
      ]
    }
  }
}
