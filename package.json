{
  "name": "rship",
  "license": "MIT",
  "scripts": {
    "server:dev": "pnpm run --filter=@rship/server dev",
    "link:dev": "pnpm run --filter=@rship/link-ui tauri-dev",
    "autoscheduler:dev": "nodemon --watch libs --watch apps/autoscheduler/src/ watch apps/autoscheduler/src/main.ts ",
    "dirigera:dev": "nodemon --watch libs --watch apps/rship/dirigera/src/ apps/rship/dirigera/src/main.ts ",
    "disguise:dev": "nodemon --watch libs --watch apps/rship/disguise/src/ apps/rship/disguise/src/main.ts ",
    "pixera:dev": "pnpm run --filter=@rship/pixera dev",
    "bms:dev": "nodemon --watch libs --watch apps/rship/pixera/src/ apps/rship/pixera/src/tools/bmsWorkflow.ts ",
    "bms:run": "ts-node apps/rship/pixera/src/tools/bmsWorkflow.ts ",
    "ventuz:dev": "nodemon --watch libs --watch apps/rship/ventuz/src/ apps/rship/ventuz/src/main.ts ",
    "noise:dev": "nodemon --watch libs --watch apps/rship/noise/src/ apps/rship/noise/src/main.ts ",
    "client:dev": "nodemon --watch libs --exec \"pnpm run --filter=@rship/client dev \" -e ts",
    "viz:dev": "nodemon --watch libs --exec \"pnpm run --filter=@rship/viz dev \" -e ts",
    "previz:dev": "pnpm run --filter=@rship/previz dev",
    "release:dev": "./tools/scripts/release.sh dev",
    "release:beta": "./tools/scripts/release.sh staging",
    "sdk:watch": "pnpm run --filter=@rship/sdk watch",
    "build": "turbo run build",
    "publish": "./tools/scripts/export-version.sh && turbo run publish",
    "forge-publish": "turbo run forge-publish",
    "rust": "./tools/scripts/rust.sh",
    "preinstall": "pnpm run rust && pnpm run sync",
    "postinstall": "pnpm run versionstamp",
    "versionstamp": "node ./tools/scripts/version-stamp.js",
    "transform": "node ./tools/scripts/transform.js",
    "gen": "node ./tools/scaffold/generate.js",
    "clear": "rm -rf $(pnpm store path) && rm -rf node_modules rm -rf **/node_modules && cargo clean",
    "setup": "pnpm run install && pnpm run sync",
    "ionic:build": "npm run build",
    "sync": "git submodule update --init --recursive --remote",
    "format": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-file .prettierignore"
  },
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^5.7.4",
    "@capacitor/core": "^5.7.4",
    "@types/node": "^20.12.7",
    "@vercel/ncc": "^0.38.1",
    "fs-extra": "^11.2.0",
    "generate-template-files": "^3.2.1",
    "git-describe": "^4.1.1",
    "glob": "^10.3.12",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-svelte": "^3.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.6.2",
    "turbo": "^1.13.2",
    "typescript": "^5.4.5"
  }
}
