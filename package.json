{
  "name": "rship",
  "version": "2.3.0",
  "license": "MIT",
  "scripts": {
    "start": "turbo run start",
    "release:dev": "./tools/scripts/release.sh dev",
    "release:beta": "./tools/scripts/release.sh staging"
  },
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@angular/common": "^14.2.12",
    "@angular/compiler-cli": "^14.2.12",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.1",
    "turbo": "^1.6.3"
  },
  "husky": {
    "hooks": {
      "post-commit": [
        "node ./tools/scripts/version-stamp.js"
      ],
      "post-checkout": [
        "node ./tools/scripts/version-stamp.js"
      ]
    }
  }
}
