{
  "name": "rship",
  "version": "2.3.0",
  "license": "MIT",
  "scripts": {
    "start": "turbo run start",
    "release:dev": "./tools/scripts/release.sh dev",
    "release:beta": "./tools/scripts/release.sh staging",
    "build": "turbo run build"
  },
  "packageManager": "pnpm",
  "workspaces": [
    "apps/**",
    "libs/**"
  ],
  "private": true,
  "devDependencies": {
    "@types/node": "^18.11.19",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "turbo": "^1.7.3",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "post-commit": [
        "node ./tools/scripts/version-stamp.js"
      ],
      "post-checkout": [
        "node ./tools/scripts/version-stamp.js"
      ]
    }
  }
}
